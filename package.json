{
  "name": "dsh-decisions-board",
  "version": "0.4.0",
  "description": "Pending-decision board in the DSH session header: agents record a decision as they ask, clicking an option fills the composer instead of sending it, and a reply in the conversation marks it decided.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "decisions",
    "decision-log",
    "adr",
    "session-ui",
    "deepseek-harness"
  ],
  "license": "MIT",
  "author": "Sandwich-git",
  "homepage": "https://github.com/Sandwich-git/dsh-decisions-board#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sandwich-git/dsh-decisions-board.git"
  },
  "bugs": {
    "url": "https://github.com/Sandwich-git/dsh-decisions-board/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./model": "./src/model.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "src/model.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "examples",
    "docs/images"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches"
      ]
    },
    "manifestVersion": 1
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node tools/build-client.mjs",
    "test": "node --test tests/model.test.mjs tests/bundle.test.mjs tests/host.test.mjs tests/client.test.mjs",
    "serve": "node tools/serve.mjs"
  }
}
